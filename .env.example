# Copy to .env (never commit it). docker compose refuses to start if any
# of these is missing. Generate the JWT secrets with: bash backend/gen-secrets.sh
FRONTEND_URL=https://yourdomain.com
DB_PASSWORD=replace_with_your_password
JWT_ACCESS_SECRET=replace_with_your_access_secret
JWT_REFRESH_SECRET=replace_with_your_refresh_secret
GOOGLE_CLIENT_ID=replace_with_your_client_id
RESEND_API_KEY=replace_with_api_key
